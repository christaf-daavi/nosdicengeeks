---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TagBadge from '../components/TagBadge.astro';
import siteConfig from '../data/site-config.json';
import { getTagsPageSlug } from '../lib/tagsSlug';
import { srcsetFor, fallbackSrcFor } from '../lib/responsiveImage';
import { readableColor, OVERLAY_WORST_BG } from '../lib/contrast';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  image?: { src: string; alt: string };
  heroLabel?: string;
  heroTitle?: string;
  heroCopy?: string;
  heroLabelColor?: string;
  heroTitleColor?: string;
  heroCopyColor?: string;
}

const {
  title, description, pubDate, updatedDate, author, tags, image,
  heroLabel, heroTitle, heroCopy,
  heroLabelColor, heroTitleColor, heroCopyColor,
} = Astro.props;

const formattedPubDate = pubDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const gtmId = siteConfig.gtmId || '';

// Colores del hero elegidos en el CMS: si no alcanzan contraste AA sobre su
// fondo se usa uno legible (p.ej. #0496ff sobre la foto oscurecida no llega).
const hasHeroText = !!(image && (heroLabel || heroTitle || heroCopy));
// El CMS usa el título como alt por defecto: en ese caso la portada solo
// repetiría el <h1> a los lectores de pantalla, así que va como decorativa.
const heroAlt = image && image.alt.trim() !== title.trim() ? image.alt : '';
const overlayColors = {
  label: readableColor(heroLabelColor, OVERLAY_WORST_BG, '#fbbc42'),
  title: readableColor(heroTitleColor, OVERLAY_WORST_BG, '#ffffff', 3), // texto grande: 3:1
  copy:  readableColor(heroCopyColor,  OVERLAY_WORST_BG, '#e2e8f0'),
};
const eyebrowColor = readableColor(heroLabelColor, '#111827', '#fbbc42'); // sobre --color-bg-card
const tagsSlug = await getTagsPageSlug();
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <BaseHead title={title} description={description} image={image?.src} />
    {gtmId && (
      <Fragment>
        <!-- Google Tag Manager -->
        <script set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${gtmId}');`} />
        <!-- End Google Tag Manager -->
      </Fragment>
    )}
  </head>
  <body>
    {gtmId && (
      <Fragment>
        <!-- Google Tag Manager (noscript) -->
        <noscript>
          <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
        </noscript>
        <!-- End Google Tag Manager (noscript) -->
      </Fragment>
    )}
    <Header />

    <main id="main-content">
      <article class="post-article">

        <!-- Hero de imagen -->
        {image && (
          <div class:list={['post-hero', { 'post-hero--has-text': hasHeroText }]}>
            <img
              src={fallbackSrcFor(image.src, 800)}
              srcset={srcsetFor(image.src)}
              sizes="100vw"
              alt={heroAlt}
              class="post-hero__img"
              width="1200"
              height="675"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            {/* El overlay repite título y descripción del <h1> de abajo: es
                decorativo (aria-hidden) y en móvil no se muestra. */}
            {hasHeroText && (
              <div class="post-hero__overlay" aria-hidden="true">
                {heroLabel && <span class="post-hero__label" style={`color:${overlayColors.label}`}>{heroLabel}</span>}
                {heroTitle && <p class="post-hero__title" style={`color:${overlayColors.title}`}>{heroTitle}</p>}
                {heroCopy && <p class="post-hero__copy" style={`color:${overlayColors.copy}`}>{heroCopy}</p>}
              </div>
            )}
          </div>
        )}

        <div class="container post-container">

          <!-- Cabecera del artículo -->
          <header class:list={['post-header', { 'post-header--under-hero': !!image }]}>
            {/* Eyebrow: solo en móvil, donde el overlay del hero no se muestra */}
            {hasHeroText && heroLabel && (
              <p class="post-eyebrow" style={`color:${eyebrowColor}`}>{heroLabel}</p>
            )}

            {tags.length > 0 && (
              <div class="post-tags">
                {tags.map((tag, i) => (
                  <TagBadge tag={tag} index={i} href={`/${tagsSlug}/${tag}`} />
                ))}
              </div>
            )}

            <h1 class="post-title">{title}</h1>
            <p class="post-description">{description}</p>

            <div class="post-meta">
              <span class="post-meta__author">
                <span class="meta-label">// autor</span>
                <a href="/about">{author}</a>
              </span>

              <span class="post-meta__sep" aria-hidden="true">·</span>

              <time class="post-meta__date" datetime={pubDate.toISOString()}>
                <span class="meta-label">// publicado</span>
                {formattedPubDate}
              </time>

              {updatedDate && (
                <>
                  <span class="post-meta__sep" aria-hidden="true">·</span>
                  <time class="post-meta__date" datetime={updatedDate.toISOString()}>
                    <span class="meta-label">// actualizado</span>
                    {formattedUpdatedDate}
                  </time>
                </>
              )}
            </div>
          </header>

          <!-- Cuerpo del artículo -->
          <div class="post-body prose">
            <slot />
          </div>

          <!-- Footer del artículo -->
          <footer class="post-footer">
            <div class="post-footer__tags">
              <span class="meta-label">// tags</span>
              {tags.map((tag, i) => (
                <TagBadge tag={tag} index={i} href={`/${tagsSlug}/${tag}`} />
              ))}
            </div>
            <a href="/" class="btn btn--outline post-footer__back">← Volver al inicio</a>
          </footer>

        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* ── Post layout ────────────────────────────────────────── */
  .post-hero {
    position: relative;
    width: 100%;
    /* 16:9 hasta 500px de alto: en tablets no se recorta de más */
    height: min(500px, 56.25vw);
    overflow: hidden;
    border-radius: 0;
    margin-bottom: var(--space-6);
    background: var(--color-bg-card);
  }

  .post-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  /* Overlay (>=768px). El degradado se mantiene en >=.72 bajo toda la columna
     de texto (hasta ~62% del ancho) para asegurar contraste AA sobre zonas
     claras de la foto; ver OVERLAY_WORST_BG en src/lib/contrast.ts. */
  .post-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right,
      rgba(5, 10, 20, 0.78) 0%,
      rgba(5, 10, 20, 0.72) 62%,
      rgba(5, 10, 20, 0.12) 100%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(24px, 4vw, 48px) clamp(24px, 5vw, 60px);
    gap: 12px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .post-hero__overlay > * {
    max-width: min(700px, 55vw);
  }

  /* Eyebrow sobre el <h1>: solo se muestra en móvil */
  .post-eyebrow {
    display: none;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .post-hero__label {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-yellow, #fbbc42);
  }

  .post-hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: white;
    line-height: 1.1;
    margin: 0;
    max-width: 700px;
  }

  .post-hero__copy {
    font-size: clamp(1rem, 2vw, 1.35rem);
    color: #e2e8f0;
    margin: 0;
    max-width: 600px;
  }

  .post-container {
    max-width: 780px;
    padding-bottom: 3rem;
  }

  .post-header {
    padding-block: var(--space-12) var(--space-8);
    border-bottom: 1px solid var(--color-border-muted);
    margin-bottom: var(--space-8);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .post-tags :global(.tag) {
    text-decoration: none;
  }

  .post-footer__tags :global(.tag) {
    text-decoration: none;
  }

  .post-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  /* Override global h1::before prompt — this title stands alone */
  .post-title::before {
    content: none;
  }

  .post-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    font-family: var(--font-code);
    font-size: var(--text-xs);
    color: var(--color-text);
    opacity: 0.8;
  }

  /* Sin opacidad propia: sumada a la de .post-meta (.8) dejaba el verde en
     ~3.6:1, por debajo de AA para texto de 12px. */
  .meta-label {
    color: var(--color-green);
    margin-right: var(--space-1);
  }

  .post-meta a {
    color: var(--color-text);
    opacity: 0.85;
  }

  .post-meta a:hover {
    opacity: 1;
    text-shadow: none;
  }

  .post-meta__sep {
    opacity: 0.4;
  }

  /* ── Prose — article body typography ────────────────────── */
  .prose {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-text);
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-size: var(--text-2xl);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-muted);
  }

  .prose :global(h2::before) {
    content: '## ';
    color: var(--color-green);
    font-weight: 300;
    opacity: 0.6;
  }

  .prose :global(h3::before) {
    content: '### ';
    color: var(--color-blue);
    font-weight: 300;
    opacity: 0.6;
  }

  .prose :global(h4::before) {
    content: none;
  }

  .prose :global(p) {
    margin-bottom: var(--space-6);
  }

  .prose :global(a) {
    color: var(--color-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(4, 150, 255, 0.4);
    transition: opacity var(--transition);
  }

  .prose :global(a:hover) {
    opacity: 0.8;
    text-shadow: none;
  }

  :global([data-theme="light"]) .prose :global(a) {
    color: var(--color-dark-blue);
    text-decoration-color: rgba(0, 107, 166, 0.4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(ul li::marker) {
    color: var(--color-green);
  }

  .prose :global(ol li::marker) {
    color: var(--color-blue);
    font-family: var(--font-code);
    font-size: var(--text-sm);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-green);
    padding: var(--space-3) var(--space-6);
    margin-block: var(--space-6);
    background: rgba(0, 255, 65, 0.04);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .prose :global(blockquote p) {
    margin-bottom: 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-6);
    font-size: var(--text-sm);
  }

  .prose :global(th) {
    background: var(--color-bg-elevated);
    color: var(--color-green);
    font-family: var(--font-code);
    font-weight: 500;
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border: 1px solid var(--color-border);
  }

  .prose :global(td) {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-muted);
  }

  .prose :global(tr:nth-child(even) td) {
    background: rgba(22, 27, 34, 0.5);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-12);
  }

  .prose :global(img) {
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    margin-block: var(--space-6);
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose :global(em) {
    color: var(--color-text-muted);
  }

  /* ── Post footer ────────────────────────────────────────── */
  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-12);
    margin-bottom: 4rem;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .post-footer__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-code);
    font-size: var(--text-xs);
  }

  .post-footer__tags .tag {
    text-decoration: none;
  }

  /* ── Hero móvil (<768px): imagen 16:9 arriba, texto debajo sobre fondo
     sólido. El overlay no se muestra: eyebrow, <h1> y descripción del
     .post-header ocupan su lugar, así el título aparece una sola vez. */
  @media (max-width: 767.98px) {
    .post-hero {
      height: auto;
      aspect-ratio: 16 / 9;
      margin-bottom: 0;
    }

    .post-hero__overlay {
      display: none;
    }

    .post-header.post-header--under-hero {
      display: flex;
      flex-direction: column;
      /* A sangre: anula el padding lateral del .container (sea cual sea) y
         lo devuelve como padding para alinear el texto con el cuerpo. */
      margin-inline: calc(50% - 50vw);
      padding: var(--space-6) calc(50vw - 50%);
      background: var(--color-bg-card);
      border-top: 3px solid var(--color-primary);
      border-bottom: none;
    }

    .post-header--under-hero .post-eyebrow { display: block; order: 0; }
    .post-header--under-hero .post-title { order: 1; }
    .post-header--under-hero .post-description { order: 2; }
    .post-header--under-hero .post-tags { order: 3; margin-bottom: var(--space-4); }
    .post-header--under-hero .post-meta { order: 4; }
  }

  @media (max-width: 768px) {
    .post-header {
      padding-block: var(--space-8) var(--space-6);
    }

    .prose {
      font-size: var(--text-base);
    }

    .post-footer {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 2.5rem;
    }
  }
</style>
