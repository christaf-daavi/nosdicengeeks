---
import TagBadge from './TagBadge.astro';
import { srcsetFor, fallbackSrcFor } from '../lib/responsiveImage';
import { formatDate, isoDate } from '../lib/formatDate';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  image?: { src: string; alt: string };
  // true en la tarjeta que queda sobre el pliegue (p. ej. la primera de una
  // página de etiqueta): su imagen puede ser el LCP y no debe ser lazy.
  priority?: boolean;
}

const { title, description, pubDate, tags, slug, image, priority = false } = Astro.props;

const formattedDate = formatDate(pubDate, 'short');

---

<article class="post-card">
  <a href={`/posts/${slug}`} class="post-card__link" aria-label={`Leer: ${title}`}>

    {image && (
      <div class="post-card__image-wrapper">
        <img
          src={fallbackSrcFor(image.src, 400)}
          srcset={srcsetFor(image.src)}
          alt={image.alt}
          class="post-card__image"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
          width="800"
          height="450"
          sizes="(max-width: 480px) calc(100vw - 34px), (max-width: 768px) calc(100vw - 50px), (max-width: 1024px) calc(50vw - 38px), min(calc(33.33vw - 35px), 366px)"
        />
      </div>
    )}

    <div class="post-card__body">
      {tags.length > 0 && (
        <div class="post-card__tags" aria-label="Etiquetas">
          {tags.slice(0, 4).map((tag, i) => (
            <TagBadge tag={tag} index={i} />
          ))}
        </div>
      )}

      <h3 class="post-card__title">{title}</h3>

      <p class="post-card__excerpt">{description}</p>

      <div class="post-card__meta">
        <time class="post-card__date" datetime={isoDate(pubDate)}>Publicado el {formattedDate}</time>
        <span class="post-card__read-more" aria-hidden="true">leer →</span>
      </div>
    </div>

  </a>
</article>

<style>
  /* Make the entire card a clickable surface */
  .post-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  /* Override global a:hover glow — card handles its own hover */
  .post-card__link:hover {
    text-shadow: none;
    color: inherit;
  }

  .post-card__read-more {
    font-family: var(--font-code);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #ffffff;
    /* var(--color-primary) (#0496ff) con texto blanco da ~3.08:1 — no
       cumple el mínimo 4.5:1 de WCAG AA. var(--color-dark-blue) (#006ba6),
       ya definida en el design system, da ~5.75:1. */
    background: var(--color-dark-blue);
    padding: 6px 16px;
    border-radius: 4px;
    white-space: nowrap;
    transition: filter var(--transition);
  }

  .post-card:hover .post-card__read-more {
    filter: brightness(0.85);
  }

  /* Ensure h3 inside card never shows the ::before prompt */
  .post-card__title::before {
    content: none !important;
  }
</style>
