---
import fs from 'node:fs';
import path from 'node:path';

const DEFAULT_MENU = [
  { href: '/',       label: 'Inicio'    },
  { href: '/tags',   label: 'Etiquetas' },
  { href: '/nosotros', label: 'Nosotros' },
];

// admin/data/site.json es contenido editable desde el CMS (gitignored: cada
// servidor tiene el suyo, no vive en git). Si falta —checkout nuevo antes de
// que el guard del deploy lo cree— el build no debe romperse por eso.
function readMenu() {
  try {
    const raw = fs.readFileSync(path.join(process.cwd(), 'admin/data/site.json'), 'utf8');
    const menu = JSON.parse(raw).menu;
    return Array.isArray(menu) && menu.length
      ? menu.map((item) => ({ href: item.href, label: item.label }))
      : DEFAULT_MENU;
  } catch {
    return DEFAULT_MENU;
  }
}

const navLinks = readMenu();

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="container">
    <a href="/" class="site-logo" aria-label="NosDicenGeeks — inicio">
      <img src="/images/logo.svg" alt="NosDicenGeeks" class="logo-img" width="72" height="72" />
    </a>

    <nav class="site-nav-wrap" aria-label="Navegación principal">
      {/* Oculto sin JS: en móvil la lista se muestra entonces como fila
          bajo el logo. Con JS el script lo muestra y la lista pasa a ser
          un panel desplegable (ver .has-menu-js en global.css). */}
      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="site-nav"
        hidden
      >
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
      </button>
      <ul class="site-nav" id="site-nav">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={currentPath === href || (href !== '/' && currentPath.startsWith(href)) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;

  // ── Glassmorphism on scroll ──────────────────────────────────
  // Batcheado con requestAnimationFrame: sin esto, scroll events rápidos
  // intercalan lecturas (scrollY) y escrituras (classList.toggle) de
  // invocaciones consecutivas dentro del mismo frame, forzando layouts
  // sincrónicos (forced reflow) en vez de dejar que el navegador los
  // agrupe antes del siguiente paint.
  let ticking = false;
  const updateHeader = () => {
    header.classList.toggle('scrolled', window.scrollY > 10);
    ticking = false;
  };
  const onScroll = () => {
    if (!ticking) {
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ── Menú móvil (<768px) ──────────────────────────────────────
  // Disclosure no modal: Esc, clic fuera o elegir un enlace lo cierran.
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const menu = document.getElementById('site-nav')!;
  const mobile = window.matchMedia('(max-width: 767.98px)');

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    header.classList.toggle('menu-open', open);
  };
  const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

  header.classList.add('has-menu-js');
  toggle.hidden = false;

  toggle.addEventListener('click', () => setOpen(!isOpen()));
  menu.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (isOpen() && !header.contains(e.target as Node)) setOpen(false);
  });
  // Al pasar a escritorio o volver con el botón "atrás" (bfcache)
  mobile.addEventListener('change', () => setOpen(false));
  window.addEventListener('pageshow', () => setOpen(false));
</script>

<style>
  .logo-img {
    height: 72px;
    width: auto;
    display: block;
    background: transparent;
  }

  @media (max-width: 768px) {
    .logo-img {
      height: 64px;
    }
  }
</style>
