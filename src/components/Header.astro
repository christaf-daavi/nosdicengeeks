---
import fs from 'node:fs';
import path from 'node:path';

const DEFAULT_MENU = [
  { href: '/',       label: 'Inicio'    },
  { href: '/tags',   label: 'Etiquetas' },
  { href: '/about',  label: 'Nosotros'  },
];

// admin/data/site.json es contenido editable desde el CMS (gitignored: cada
// servidor tiene el suyo, no vive en git). Si falta —checkout nuevo antes de
// que el guard del deploy lo cree— el build no debe romperse por eso.
function readMenu() {
  try {
    const raw = fs.readFileSync(path.join(process.cwd(), 'admin/data/site.json'), 'utf8');
    const menu = JSON.parse(raw).menu;
    return Array.isArray(menu) && menu.length
      ? menu.map((item) => ({ href: item.href, label: item.label }))
      : DEFAULT_MENU;
  } catch {
    return DEFAULT_MENU;
  }
}

const navLinks = readMenu();

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="container">
    <a href="/" class="site-logo" aria-label="NosDicenGeeks — inicio">
      <img src="/images/logo.svg" alt="NosDicenGeeks" class="logo-img" width="72" height="72" />
    </a>

    <nav aria-label="Navegación principal">
      <ul class="site-nav">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={currentPath === href || (href !== '/' && currentPath.startsWith(href)) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;

  // ── Glassmorphism on scroll ──────────────────────────────────
  // Batcheado con requestAnimationFrame: sin esto, scroll events rápidos
  // intercalan lecturas (scrollY) y escrituras (classList.toggle) de
  // invocaciones consecutivas dentro del mismo frame, forzando layouts
  // sincrónicos (forced reflow) en vez de dejar que el navegador los
  // agrupe antes del siguiente paint.
  let ticking = false;
  const updateHeader = () => {
    header.classList.toggle('scrolled', window.scrollY > 10);
    ticking = false;
  };
  const onScroll = () => {
    if (!ticking) {
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .logo-img {
    height: 72px;
    width: auto;
    display: block;
    background: transparent;
  }

  @media (max-width: 768px) {
    .logo-img {
      height: 64px;
    }

    .site-nav {
      display: none;
    }
  }
</style>
